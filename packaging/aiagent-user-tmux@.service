; packaging/aiagent-user-tmux@.service — one user's tmux server and agent.
; A session named after the user is open from the start (agent-loop.sh).
[Unit]
Description=agent of %i
After=network-online.target

[Service]
Type=forking
User=%i
WorkingDirectory=/home/%i/work
RuntimeDirectory=aiagent-tmux/%i
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
Environment=PATH=/home/%i/.local/bin:/usr/local/bin:/usr/bin:/bin LANG=C.UTF-8 TERM=xterm-256color SHELL=/bin/bash
Environment=TMUX_TMPDIR=/run/aiagent-tmux/%i
; optional: one Claude token for every room (packaging/claude-token.sh)
EnvironmentFile=-/etc/aiagent/claude.env
ExecStart=/usr/bin/tmux new-session -d -s core -n %i -x 180 -y 50 "/usr/local/lib/aiagent/agent-loop.sh %i"
Restart=always
RestartSec=5
; the loop would reopen claude; nothing here needs a slow goodbye
TimeoutStopSec=3
NoNewPrivileges=yes
MemoryMax=8G
TasksMax=1024

[Install]
WantedBy=multi-user.target
